# Build time (inlined into the browser bundle; set by the Dockerfile / CI, `npm run dev` sets it too):
NEXT_PUBLIC_THEMIS_API_BASE=/api/themis

# Runtime, server-side only (the BFF):
THEMIS_SERVICE_URL=http://localhost:8080
# Only when themis-service runs auth.mode=gateway-secret; leave unset for mode: none.
THEMIS_GATEWAY_SECRET=
